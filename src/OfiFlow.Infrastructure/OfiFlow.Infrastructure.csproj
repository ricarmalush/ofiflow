<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <!-- La fuente del PDF (spec 025 D8): va dentro del ensamblado; un servidor Linux no trae fuentes del sistema. Ver Documents/Fonts/README.md. -->
    <EmbeddedResource Include="Documents\Fonts\*.ttf" LogicalName="OfiFlow.Fonts.%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\OfiFlow.Domain\OfiFlow.Domain.csproj" />
    <ProjectReference Include="..\OfiFlow.Application\OfiFlow.Application.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.12" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.12">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="MailKit" Version="4.18.2" />
    <!--
      El PDF del presupuesto (spec 025 D2). Licencia MIT SOLO hasta la 6.2.4: la 6.5.0 y la 7.0.0-preview-2 (14-10-2026) pasaron a AGPL-3.0, que obligaría a
      publicar el código de todo lo que se enlace con ellas. Por eso se fija esta versión y .github/dependabot.yml ignora las posteriores a la 6.2.
      Un test (QuotePdfDependencyLicenseTests) comprueba en el .nuspec que los paquetes usados siguen siendo MIT.
    -->
    <PackageReference Include="PDFsharp-MigraDoc" Version="6.2.4" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" Version="10.0.12" />
    <!--
      Dependencia transitiva (Microsoft.Data.SqlClient, incluida la 6.1.7, pide la 9.0.11) con una
      vulnerabilidad de denegación de servicio de severidad alta: CVE-2026-84008 / GHSA-846f-f764-76mx
      (corregida en la 10.0.13). Se fija aquí, como dependencia directa, porque NuGet elige la
      versión más cercana al proyecto. Quitar esta línea cuando SqlClient publique una versión que
      dependa de una Pkcs corregida (ADR-010, NuGetAudit con NU1903 como error).
    -->
    <PackageReference Include="System.Security.Cryptography.Pkcs" Version="10.0.13" />
  </ItemGroup>

</Project>
